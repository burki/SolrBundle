{
    "name": "boppy/solr-bundle",
    "type": "symfony-bundle",
    "description": "Forked from floriansemm/solr-bundle - Symfony >= 6.4 Solr integration bundle",
    "keywords": [
        "search",
        "index",
        "symfony",
        "solr"
    ],
    "homepage": "https://github.com/burki/SolrBundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "solarium/solarium": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/doctrine-bridge": "^6.4|^7.0|^8.0",
        "burki/minimalcode-search": "^1.0",
        "ramsey/uuid": "^3.5|^4.1",
        "myclabs/deep-copy": "^1.6"
    },
    "require-dev": {
        "doctrine/orm": "^2.20|^3.6",
        "phpunit/phpunit": "^9.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "FS\\SolrBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FS\\SolrBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "bin-dir": "bin"
    },
    "suggest": {
        "doctrine/orm": "Required if you want to use the Doctrine ORM"
    }
}
